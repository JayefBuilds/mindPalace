# Copy this file to .env and fill in your values
# docker compose will load .env automatically

# --- Auth ---
# Anthropic API key (pay-per-token, from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-...

# --- Agent ID ---
# Default agent/project ID used by the MCP server
MEM0_AGENT_ID=my-project

# --- Optional overrides (defaults shown) ---
# MEM0_LLM_MODEL=claude-haiku-4-5-20251001
# MEM0_EMBEDDING_MODEL=nomic-embed-text
# MEM0_ENABLE_GRAPH=false
# MEM0_ENABLE_RERANKER=true
# MEM0_ENABLE_REWRITER=true
# MEM0_FINAL_LIMIT=5
